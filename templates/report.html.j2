<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Personal Investor Assistant — Watchlist Pulse</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="{{ asset_path }}/report.css" />
</head>
<body>
  <header>
    <h1>Personal Investor Assistant — Watchlist Pulse</h1>
    <div class="sub">Generated: {{ generated_at }}</div>
  </header>

  <div class="container">
    {% if warnings %}
    <div class="warn-box">
      <strong>Warnings</strong>
      <ul>
        {% for w in warnings %}
        <li>{{ w }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <section style="margin-bottom:24px;">
      <h2>Portfolio Overview</h2>
      <div class="cards">
        <div class="card">
          <div class="card-label">Latest Composite</div>
          <div class="card-value">
            {% if latest_portfolio_composite is not none and latest_portfolio_composite == latest_portfolio_composite %}
              {{ "%.3f"|format(latest_portfolio_composite) }}
            {% else %}
              --
            {% endif %}
          </div>
        </div>
        <div class="card">
          <div class="card-label">YTD Return (Eq-weight)</div>
          <div class="card-value">
            {% if portfolio_return is not none and portfolio_return == portfolio_return %}
              {{ "%.1f%%"|format(portfolio_return * 100) }}
            {% else %}
              --
            {% endif %}
          </div>
        </div>
        <div class="card">
          <div class="card-label">Latest Drawdown</div>
          <div class="card-value">
            {% if portfolio_drawdown is not none and portfolio_drawdown == portfolio_drawdown %}
              {{ "%.1f%%"|format(portfolio_drawdown * 100) }}
            {% else %}
              --
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    <section style="margin-bottom:24px;">
      <h2>Composite History</h2>
      {% if composite_history %}
      <table class="table">
        <thead>
          <tr><th>Date</th><th>Weighted Composite</th></tr>
        </thead>
        <tbody>
          {% for entry in composite_history[-10:] %}
          <tr>
            <td style="text-align:left;">{{ entry.date }}</td>
            <td>{{ "%.3f"|format(entry.value) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="sub">No composite history captured yet.</p>
      {% endif %}
    </section>

    <section>
      <h2>Watchlist Detail</h2>
      <div class="table-actions">
        <input type="text" data-filter placeholder="Filter by ticker or note" />
        <a class="chip" href="{{ base_path }}/pulse/index.html">Pulse archive</a>
      </div>

      <table class="table" data-sortable>
        <thead>
          <tr>
            <th data-key="ticker">Ticker</th>
            <th data-key="note">Note</th>
            <th data-key="price">Price</th>
            <th data-key="composite">Composite</th>
            <th data-key="composite_pct">Composite %</th>
            <th data-key="composite_delta">Δ 1d</th>
            <th data-key="composite_delta_7d">Δ 7d</th>
            <th data-key="value_pct">Value %</th>
            <th data-key="quality_pct">Quality %</th>
            <th data-key="momentum_pct">Momentum %</th>
            <th data-key="piotroski">Pio F</th>
            <th data-key="volatility">Vol 30d</th>
            <th data-key="sharpe">Sharpe 1y</th>
            <th data-key="industry">Industry</th>
            <th data-key="filed">Last Filing</th>
          </tr>
        </thead>

        <tbody>
          {% for r in watch_rows %}
          <tr data-ticker="{{ r.ticker }}" data-note="{{ r.note }}">
            <td><a class="chip" href="{{ base_path }}/ticker/{{ r.ticker }}.html">{{ r.ticker }}</a></td>
            <td style="text-align:left; max-width:220px;">{{ r.note }}</td>

            <td>{% if r.price == r.price %}{{ "%.2f"|format(r.price) }}{% else %}--{% endif %}</td>
            <td>{% if r.composite == r.composite %}{{ "%.3f"|format(r.composite) }}{% else %}--{% endif %}</td>
            <td>{% if r.composite_pct == r.composite_pct %}{{ "%.1f"|format(r.composite_pct) }}{% else %}--{% endif %}</td>

            <td>{% if r.composite_delta == r.composite_delta %}{{ "%.2f"|format(r.composite_delta) }}{% else %}--{% endif %}</td>
            <td>{% if r.composite_delta_7d == r.composite_delta_7d %}{{ "%.2f"|format(r.composite_delta_7d) }}{% else %}--{% endif %}</td>

            <td>{% if r.value_pct == r.value_pct %}{{ "%.1f"|format(r.value_pct) }}{% else %}--{% endif %}</td>
            <td>{% if r.quality_pct == r.quality_pct %}{{ "%.1f"|format(r.quality_pct) }}{% else %}--{% endif %}</td>
            <td>{% if r.momentum_pct == r.momentum_pct %}{{ "%.1f"|format(r.momentum_pct) }}{% else %}--{% endif %}</td>

            <td>{% if r.piotroski == r.piotroski %}{{ "%.0f"|format(r.piotroski) }}{% else %}--{% endif %}</td>
            <td>{% if r.volatility == r.volatility %}{{ "%.2f"|format(r.volatility) }}{% else %}--{% endif %}</td>
            <td>{% if r.sharpe == r.sharpe %}{{ "%.2f"|format(r.sharpe) }}{% else %}--{% endif %}</td>

            <td>{{ r.industry or "--" }}</td>

            <td>
              {% if r.filing_url %}
                <a href="{{ r.filing_url }}" target="_blank" rel="noopener">
                  {{ r.filed or "View" }}
                </a>
              {% else %}
                {{ r.filed or "--" }}
              {% endif %}
              {% if r.data_quality %}
                <div>
                  {% for tag in r.data_quality %}
                    <span class="badge">{{ tag }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <div class="footer">Educational use only. Not investment advice.</div>
  </div>

  <script src="{{ asset_path }}/report.js"></script>
</body>
</html>
